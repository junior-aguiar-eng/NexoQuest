{
  "name": "nexoquiz",
  "version": "1.0.0",
  "description": "Engine de questões jurídicas interativas para ChatGPT MCP e Standalone",
  "type": "module",
  "main": "./dist/server/index.js",
  "types": "./dist/server/index.d.ts",
  "bin": {
    "nexoquiz": "./dist/server/index.js"
  },
  "exports": {
    ".": {
      "import": "./dist/server/index.js",
      "types": "./dist/server/index.d.ts"
    },
    "./stdio": {
      "import": "./dist/server/stdio.js"
    },
    "./worker": {
      "import": "./dist/server/worker.js"
    }
  },
  "files": [
    "dist/"
  ],
  "scripts": {
    "build": "tsc && vite build --config view/vite.config.ts",
    "build:server": "tsc",
    "build:view": "vite build --config view/vite.config.ts",
    "dev": "tsx watch src/index.ts",
    "dev:view": "vite --config view/vite.config.ts",
    "preview:view": "vite preview --config view/vite.config.ts",
    "start": "node dist/server/index.js",
    "start:stdio": "node dist/server/stdio.js",
    "build:worker": "npm run build:view && node scripts/build-worker-bundle.mjs && tsc",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/**/*.test.ts",
    "verify:e2e": "tsx scripts/verify-e2e.ts",
    "library:validate": "tsx scripts/validate-library.ts",
    "library:index": "tsx scripts/index-library.ts",
    "library:import": "tsx scripts/import-nexojuris.ts",
    "cli": "tsx src/cli/index.ts",
    "clean": "rm -rf dist",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "^1.7.5",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "gray-matter": "^4.0.3",
    "remark-parse": "^11.0.0",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/express": "^5.0.6",
    "@types/mdast": "^4.0.4",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/unist": "^3.0.3",
    "@vitejs/plugin-react": "^4.7.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "vite": "^6.4.3",
    "vite-plugin-singlefile": "^2.3.3",
    "vitepress": "^1.6.4",
    "zustand": "^5.0.15"
  },
  "overrides": {
    "qs": "^6.16.0",
    "body-parser": "^1.20.6",
    "esbuild": "^0.25.0",
    "vite": "^6.4.3"
  },
  "license": "MIT"
}
